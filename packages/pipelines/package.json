{
  "name": "@railway-ts/pipelines",
  "version": "0.2.0",
  "description": "Railway-oriented pipelines for TypeScript: a lightweight fp-style Result/Option and schema layer for handling errors and validating boundaries.",
  "type": "module",
  "exports": {
    "./option": {
      "types": "./dist/option/index.d.mts",
      "default": "./dist/option/index.mjs"
    },
    "./result": {
      "types": "./dist/result/index.d.mts",
      "default": "./dist/result/index.mjs"
    },
    "./composition": {
      "types": "./dist/composition/index.d.mts",
      "default": "./dist/composition/index.mjs"
    },
    "./schema": {
      "types": "./dist/schema/index.d.mts",
      "default": "./dist/schema/index.mjs"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "mkdir -p coverage && bun test --coverage --coverage-reporter=lcov",
    "test:package": "bun run build && tsc -p tests/package && node tests/package/runtime.mjs"
  },
  "keywords": [
    "railway",
    "railway-oriented",
    "pipeline",
    "pipelines",
    "error-handling",
    "result",
    "option",
    "functional-programming",
    "fp-ts",
    "effect-ts",
    "composition",
    "pipe",
    "flow",
    "typescript",
    "schema-validation",
    "validation",
    "runtime-validation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakobu/railway-ts.git",
    "directory": "packages/pipelines"
  },
  "homepage": "https://github.com/sakobu/railway-ts/tree/main/packages/pipelines#readme",
  "bugs": {
    "url": "https://github.com/sakobu/railway-ts/issues"
  },
  "author": "Sarkis Melkonian",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "typescript": ">=5.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
