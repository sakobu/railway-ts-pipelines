{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Path alias configuration
    "paths": {
      "@/*": ["./src/*"],
      "@tests/*": ["./tests/*"]
    },

    // Stricter flags
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true
  },
  "include": ["src", "tests", "examples", "scripts", "*.ts", "*.js"],
  // tests/package type-checks the built package with its own tsconfig.json
  "exclude": ["tests/package"]
}
