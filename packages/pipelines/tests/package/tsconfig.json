{
  // Type-checks tests/package/*.{ts,cts} against the BUILT package (dist/),
  // resolved by name through package.json "exports", the way a consumer sees it.
  // skipLibCheck is off so broken published declarations fail here.
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    // Consumers are checked with the strictest optional-property setting, so the published
    // types must say when an optional key can hold undefined.
    "exactOptionalPropertyTypes": true,
    "types": []
  },
  "include": ["*.ts", "*.cts"]
}
