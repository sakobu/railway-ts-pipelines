{
  "name": "@railway-ts/use-form",
  "version": "0.9.0",
  "description": "React form hook that works with @railway-ts/pipelines to manage form state, validation, and submission.",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "example": "bun --hot examples/server.ts",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "mkdir -p coverage && bun test --coverage --coverage-reporter=lcov"
  },
  "keywords": [
    "react",
    "form",
    "hooks",
    "validation",
    "railway",
    "typescript",
    "type-safe"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakobu/railway-ts.git",
    "directory": "packages/use-form"
  },
  "homepage": "https://github.com/sakobu/railway-ts/tree/main/packages/use-form#readme",
  "bugs": {
    "url": "https://github.com/sakobu/railway-ts/issues"
  },
  "author": "Sarkis Melkonian",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@railway-ts/pipelines": "^0.6.0",
    "react": "^19.0.0",
    "typescript": ">=6.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@railway-ts/pipelines": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "arktype": "^2.2.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "valibot": "^1.5.0",
    "zod": "^4.6.7"
  }
}
