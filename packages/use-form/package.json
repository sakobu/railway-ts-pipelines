{
  "name": "@railway-ts/use-form",
  "version": "0.1.33",
  "description": "React form hook that works with @railway-ts/pipelines to manage form state, validation, and submission.",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "example": "bun --hot examples/server.ts",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "mkdir -p coverage && bun test --coverage --coverage-reporter=lcov"
  },
  "keywords": [
    "react",
    "form",
    "hooks",
    "validation",
    "railway",
    "typescript",
    "type-safe"
  ],
  "repository": "github:sakobu/railway-ts-use-form",
  "homepage": "https://github.com/sakobu/railway-ts-use-form#readme",
  "bugs": {
    "url": "https://github.com/sakobu/railway-ts-use-form/issues"
  },
  "author": "Sarkis Melkonian",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@railway-ts/pipelines": "^0.1.27",
    "react": "^18.0.0 || ^19.0.0",
    "typescript": ">=5.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@railway-ts/pipelines": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "valibot": "^1.3.1",
    "zod": "^4.3.6"
  }
}
