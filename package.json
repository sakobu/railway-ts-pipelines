{
  "name": "@railway-ts/pipelines",
  "version": "0.1.30",
  "description": "Railway-oriented pipelines for TypeScript: a lightweight fp-style Result/Option and schema layer for handling errors and validating boundaries.",
  "type": "module",
  "exports": {
    "./option": {
      "import": {
        "types": "./dist/option/index.d.mts",
        "default": "./dist/option/index.mjs"
      },
      "require": {
        "types": "./dist/option/index.d.cts",
        "default": "./dist/option/index.cjs"
      }
    },
    "./result": {
      "import": {
        "types": "./dist/result/index.d.mts",
        "default": "./dist/result/index.mjs"
      },
      "require": {
        "types": "./dist/result/index.d.cts",
        "default": "./dist/result/index.cjs"
      }
    },
    "./composition": {
      "import": {
        "types": "./dist/composition/index.d.mts",
        "default": "./dist/composition/index.mjs"
      },
      "require": {
        "types": "./dist/composition/index.d.cts",
        "default": "./dist/composition/index.cjs"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/schema/index.d.mts",
        "default": "./dist/schema/index.mjs"
      },
      "require": {
        "types": "./dist/schema/index.d.cts",
        "default": "./dist/schema/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "dev": "tsdown --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:coverage:lcov": "mkdir -p coverage && bun test --coverage --coverage-reporter=lcov",
    "test:bail": "bun test --bail",
    "test:fast": "bun test --bail --timeout=1000",
    "test:pattern": "bun test --test-name-pattern",
    "test:only": "bun test --only",
    "test:reporter": "bun test --reporter=junit --reporter-outfile=junit.xml",
    "lint": "bunx eslint .",
    "lint:fix": "bunx eslint . --fix",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "typecheck": "bunx tsc --noEmit",
    "size": "bunx size-limit",
    "prepublishOnly": "bun run typecheck && bun run lint && bun run test && bun run test:package && bun run size",
    "check": "bun run typecheck && bun run lint && bun run test",
    "test:package": "bun run build && tsc -p tests/package && node tests/package/runtime.mjs"
  },
  "size-limit": [
    {
      "path": "dist/option/index.mjs",
      "limit": "2 kB"
    },
    {
      "path": "dist/result/index.mjs",
      "limit": "4 kB"
    },
    {
      "path": "dist/composition/index.mjs",
      "limit": "2 kB"
    },
    {
      "path": "dist/schema/index.mjs",
      "limit": "10 kB"
    }
  ],
  "keywords": [
    "railway",
    "railway-oriented",
    "pipeline",
    "pipelines",
    "error-handling",
    "result",
    "option",
    "functional-programming",
    "fp-ts",
    "effect-ts",
    "composition",
    "pipe",
    "flow",
    "typescript",
    "schema-validation",
    "validation",
    "runtime-validation"
  ],
  "repository": "github:sakobu/railway-ts-pipelines",
  "homepage": "https://github.com/sakobu/railway-ts-pipelines#readme",
  "bugs": {
    "url": "https://github.com/sakobu/railway-ts-pipelines/issues"
  },
  "author": "Sarkis Melkonian",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/bun": "1.4.5",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-unicorn": "^80.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "publint": "0.3.25",
    "size-limit": "^14.3.0",
    "tsdown": "0.23.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0"
  }
}
